{
  "manifest_version": 3,
  "name": "FrictionLayer",
  "version": "1.0.0",
  "description": "Adds a countdown before distracting websites load. Optionally makes the wait longer every time you open them in a day.",
  "browser_specific_settings": {
    "gecko": {
      "id": "frictionlayer@wheninwome.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": ["storage", "webRequest", "webRequestBlocking"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["lib/common.js", "background/background.js"] },
  "action": {
    "default_icon": "icons/icon.svg",
    "default_title": "FrictionLayer settings"
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "web_accessible_resources": [
    { "resources": ["interstitial/interstitial.html"], "matches": ["<all_urls>"] }
  ]
}
